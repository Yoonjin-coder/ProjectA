enum MealPlan {
    NONE(0),
    BREAKFAST(20.0),
    DINNER(20.0),
    BOTH(35.0);

    private double price;

    MealPlan(double price) {
        this.price = price;
    }

    double getPrice() {
        return price;
    }
}

enum RoomType {
    SINGLE(1),
    DOUBLE(2),
    FAMILY(4);

    private int numberOfCustomers;

    RoomType(int numberOfCustomers) {
        this.numberOfCustomers = numberOfCustomers;
    }

    int getNumberOfCustomers() {
        return numberOfCustomers;
    }
}

